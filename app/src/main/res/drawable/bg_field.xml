<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: outlined, with the accent outline while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/app_field" />
            <stroke android:width="2dp" android:color="@color/app_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/app_field" />
            <stroke android:width="1dp" android:color="@color/app_field_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
